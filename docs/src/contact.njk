---
layout: layout.njk
title: Contact
description: Contact Joel Sodeman, Broker at Sodeman Realty.
---

<section class="container section">
  <h1>Contact</h1>
  <p class="muted">Call, email, or request a consultation with {{ site.broker }}.</p>

  <div class="cta">
    <a class="btn-primary" href="tel:{{ site.phone_tel }}">Call {{ site.phone_display }}</a>
    <a class="btn-secondary" href="mailto:{{ site.email }}">{{ site.email }}</a>
    <a class="btn-outline" href="#schedule">Request a Consultation</a>
  </div>

  <div id="schedule" class="schedule-panel" style="margin-top:22px">
    <h2>Request a consultation</h2>
    {% if site.calendly_url %}
      <p class="muted">Pick a time that works. You’ll get a calendar confirmation after booking.</p>
      <div class="cta" style="margin-bottom:14px">
        <a class="btn-secondary" href="{{ site.calendly_url }}" target="_blank" rel="noopener">Open scheduling page</a>
      </div>
      <div id="calendly" style="min-height:760px;border:1px solid rgba(0,0,0,.08);border-radius:16px;overflow:hidden;background:#fff"></div>
      <script src="https://assets.calendly.com/assets/external/widget.js" async></script>
      <script>
        window.addEventListener("load", function(){
          if (!window.Calendly) return;
          Calendly.initInlineWidget({
            url: "{{ site.calendly_url }}",
            parentElement: document.getElementById("calendly")
          });
        });
      </script>
    {% else %}
      <p class="muted">
        Online calendar booking isn’t live yet. The fastest paths are a call or a short email with a few preferred times—
        Joel will confirm a slot that works.
      </p>
      <div class="cards schedule-options">
        <div class="card">
          <h3>Call</h3>
          <p>Speak directly and set a time in one conversation.</p>
          <a class="btn-primary" href="tel:{{ site.phone_tel }}">Call {{ site.phone_display }}</a>
        </div>
        <div class="card">
          <h3>Email a time request</h3>
          <p>Opens your mail app with a short template you can edit before sending.</p>
          <a class="btn-secondary" href="{{ site.schedule_mailto }}">Email consultation request</a>
        </div>
      </div>
    {% endif %}
  </div>

  {% if site.profiles.length %}
    <div style="margin-top:28px">
      <h2>Find Joel online</h2>
      <p class="muted">Recent sales and {{ reviews.count }} client reviews ({{ reviews.rating }} average) are public on Zillow.</p>
      <div class="cta">
        {% for profile in site.profiles %}
          <a class="btn-outline" href="{{ profile.url }}" target="_blank" rel="noopener">{{ profile.label }}</a>
        {% endfor %}
      </div>
    </div>
  {% endif %}
</section>
